#!/bin/sh
# pre-push — 올라갈 커밋들 안에 시크릿 파일이 있으면 push 를 거부한다 (pre-commit 을 --no-verify 로 건너뛴 경우의 마지막 방어).
#   stdin: "<local ref> <local sha> <remote ref> <remote sha>" 한 줄씩.
set -eu
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # 브랜치 삭제
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"   # 새 브랜치: 원격 어디에도 없는 커밋만
  else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086
  bad=$(git log --pretty=format: --name-only --diff-filter=ACMR $range | grep -E '(^|/)(\.dev\.vars|\.env)(\.[A-Za-z0-9_-]+)*$' | grep -vE '\.(example|sample|template)$' | sort -u || true)
  if [ -n "$bad" ]; then
    echo "✗ push 거부 — $local_ref 에 시크릿 파일이 커밋돼 있다:" >&2
    printf '    %s\n' $bad >&2
    echo "  이력에서 빼야 한다: git rm --cached <파일> 후 커밋, 이미 여러 커밋이면 git filter-repo. 키는 재발급." >&2
    status=1
  fi
done
exit $status
