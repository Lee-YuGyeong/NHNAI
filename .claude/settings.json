{
  "permissions": {
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.local)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.local)",
      "Write(**/.dev.vars)",
      "Write(**/.dev.vars.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler secret*)",
      "Bash(cat .dev.vars*)",
      "Bash(cat ./.dev.vars*)",
      "Bash(head .dev.vars*)",
      "Bash(tail .dev.vars*)",
      "Bash(less .dev.vars*)",
      "Bash(more .dev.vars*)",
      "Bash(sed * .dev.vars*)",
      "Bash(source .dev.vars*)",
      "Bash(. .dev.vars*)",
      "Bash(. ./.dev.vars*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(sed * .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)",
      "Bash(. ./.env*)",
      "Bash(rg --no-ignore*)",
      "Bash(rg -uu*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
