# ───────────────────────────────────────────────────────────────────────
# 시크릿 이름 목록 — 값은 비워 둔다. 커밋되는 건 이 파일뿐이다.
#
#   cp .dev.vars.example .dev.vars      ← 실제 값은 .dev.vars 에 각자 자기 키로
#   npm run vars:check                   ← 뭐가 들어갔는지만 확인 (값은 안 보여준다)
#
# 읽는 쪽 (README "키 · 시크릿" 절)
#   워커  npm run worker:dev        wrangler 가 .dev.vars 를 자동으로 읽는다 → env.XXX
#   MCP   .mcp.json → uxpilot       tools/mcp-uxpilot.mjs 가 읽어 mcp-remote 에 넘긴다
#   도구  tools/*.mjs               필요하면 tools/load-vars.mjs 의 loadVars()
#   한 번 node tools/load-vars.mjs -- <명령>
# 셸에 같은 이름의 변수가 이미 있으면 셸 값이 이긴다.
#
# .dev.vars 는 gitignore · Claude 훅(.claude/hooks/guard.mjs) · git 훅(tools/git-hooks) 세 겹으로 막혀 있다.
# 새 키가 필요하면 여기에 이름 + 용도 한 줄을 먼저 올린다.
#
# Tripo 는 키로 공유하지 않는다 — Studio 구독 크레딧은 API 키(tsk_)와 지갑이 달라 키로는 못 쓴다.
#   부품 생성: npx @tripo3d/cli auth login --email <Studio 계정> 로그인 후 tools/tripo-studio-parts.sh
# ───────────────────────────────────────────────────────────────────────

# ── UI 디자인 — uxpilot MCP ─────────────────────────────────────────────
# .mcp.json 의 uxpilot 서버(tools/mcp-uxpilot.mjs). uxpilot.ai 에서 발급한 MCP 키, `ep_` 로 시작. "Bearer " 는 붙이지 않는다.
UXPILOT_API_KEY=

# ── 워커 (npm run worker:dev) ──────────────────────────────────────────
# /api/lab — 배포된 워커에서 AI 다섯을 돌릴 때. 로컬 /lab 은 이 머신의 Claude 구독 인증을 써서 비워도 된다.
ANTHROPIC_API_KEY=
# /api/tts — 리더 방송 음성. 없으면 503 (텍스트만 나온다).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── 계정 · 구글 로그인 (worker/src/auth.ts) ────────────────────────────
# humanish 가 쓰는 **같은 Supabase 프로젝트**를 쓴다. 그래서 구글 콘솔은 손댈 것이 없다 —
# 구글이 아는 리디렉션 주소는 `https://<ref>.supabase.co/auth/v1/callback` 하나이고,
# 그건 앱 주소가 아니라 Supabase 주소라 앱이 늘어나도 그대로다.
#
# 대시보드에서 한 번만 할 일 (Authentication → URL Configuration → Redirect URLs):
#   http://localhost:5173/**          ← 로컬. humanish 의 :3000 과 같이 등록해도 서로 방해하지 않는다
#   https://<배포 주소>/**            ← 배포할 때 한 줄 더. 코드는 안 고친다
# Site URL 은 humanish 것 그대로 둔다. 여기서는 redirect_to 로 넘긴다.
#
# ★ 셋 중 하나라도 비면 로그인이 **통째로 꺼진다.** 고장이 아니다 — 이 게임은 로그인
#   없이 도는 것이 정상이고 (src/shared/guest.ts), 화면은 로그인 단추를 아예 안 그린다.
#
# 값은 humanish 의 로컬 시크릿 파일에 이미 있는 것과 같다 (Project Settings → API):
#   SUPABASE_URL      = NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_ANON_KEY = NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_URL=
# 브라우저까지 나가는 공개 키다 (GET /api/config). 숨기는 값이 아니고, 권한은 키가 아니라
# RLS 가 지킨다 — 이 저장소는 humanish supabase/policies.sql 의 profiles_select_own 에만 기댄다.
SUPABASE_ANON_KEY=
# 방 입장권 서명용. 아무 랜덤 문자열이면 된다:  openssl rand -hex 32
# 끊는 쪽과 검증하는 쪽이 같은 워커라 나눠 가질 상대가 없다 — 이 값 하나면 된다.
# (humanish 는 Next 와 워커가 나눠 가져서 WORLD_SHARED_SECRET 을 양쪽에 넣어야 했다)
WORLD_TICKET_SECRET=

# ── 표를 만들 때만 (supabase/apply.sh) ─────────────────────────────────
# Postgres 에 직접 붙는 접속 문자열. `npm run db:apply` 가 스키마를 올릴 때만 쓴다.
#
# ★ **런타임에는 안 쓴다.** 코드 어디에서도 이 이름을 읽지 않는다 — supabase-js 는
#   PostgREST(HTTP)로 붙어서 이 값을 볼 일이 없다. 표를 만드는(DDL) 통로일 뿐이다.
#
#   로컬에서는 wrangler 가 이 파일을 통째로 읽어서 `npm run worker:dev` 의 바인딩 목록에
#   이 이름도 뜬다. 그건 막을 수 없고 (파일 하나만 읽는다), 로컬이라 문제도 아니다.
#   **배포된 워커에는 넣지 마라** — 대시보드 Variables and Secrets 에 이 이름을 추가하지
#   않으면 된다. 런타임이 안 쓰는 값을 인터넷에 붙은 프로세스에 둘 이유가 없다.
#
# ★ 이 값은 **이 DB 전체에 대한 쓰기 권한**이고, 이 DB 는 humanish 와 공유다.
#   그래서 스크립트가 세 겹으로 막는다 (supabase/apply.sh 머리말):
#     붙기 전  SQL 에 public. · drop schema · truncate 가 있으면 거부  (supabase/fence.sh)
#     적용 중  search_path 를 wih 로 고정 — 이름을 안 적으면 wih 로 간다
#     적용 후  public 의 표 목록이 그대로인지 대조
#   울타리 자가 점검: npm run db:fence  (DB 없이 돈다)
#
# ★ 없어도 게임은 전부 돈다. 이 저장소는 표를 하나도 안 쓴다 (방은 Durable Object).
#   전적처럼 판을 넘어 남아야 할 것이 생겼을 때 그때 넣는다.
#
# Project Settings → Database → Connection string 에서 통째로 복사한다.
#   1. 위의 SUPABASE_URL 과 **다른 값**이다. https:// 로 시작하는 주소를 여기 넣으면 안 된다.
#   2. 복사하면 비밀번호 자리가 [YOUR-PASSWORD] 껍데기다. 실제 DB 비밀번호로 바꾼다
#      (@ : / ? # 가 있으면 URL 인코딩 — @ → %40).
#   3. "Direct connection" 은 IPv6 전용이라 국내 네트워크에서는 대개 안 붙는다.
#      그때는 같은 화면의 "Session pooler" (포트 5432 그대로). Transaction pooler(6543)는 쓰지 않는다.
#      아이디에 점이 붙고 주소가 pooler.supabase.com 이면 제대로 고른 것이다:
#      postgresql://postgres.<ref>:<비번>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_DIRECT=

# ── 예약 — 아직 코드에서 읽지 않는다 ─────────────────────────────────
# ★ service role 은 **로그인에 필요 없다.** 워커가 하는 일(토큰 확인 · 이름 읽기)은 전부
#   사용자 자신의 토큰으로 하고 RLS 를 그대로 지난다. 새면 RLS 가 통째로 무의미해지는 키라,
#   쓸 일이 없으면 워커에 두지 않는 편이 낫다.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_API_TOKEN=
